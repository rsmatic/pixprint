# PixPrint API site. Installed to ~/eaglemark/caddy/pixprint.caddy on the server (the folder
# orderko's Caddy already mounts) and imported from the Caddyfile there.
# Own hostname, so Caddy gets it its own Let's Encrypt certificate.
pixprint.54-227-48-13.sslip.io {
	encode gzip
	reverse_proxy pixprint-api:4000
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
